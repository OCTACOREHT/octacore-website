# Normalize line endings in the repository to LF
# Auto-detect text files and normalize to LF in the repo
* text=auto

# Enforce LF for common text file types
*.ts     eol=lf
*.tsx    eol=lf
*.js     eol=lf
*.jsx    eol=lf
*.json   eol=lf
*.css    eol=lf
*.scss   eol=lf
*.md     eol=lf
*.html   eol=lf
*.yml    eol=lf
*.yaml   eol=lf
*.map    eol=lf
